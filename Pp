def limpiar_titulo_pelicula(titulo_bruto):
    titulo = str(titulo_bruto).upper().replace('"', '').replace("'", "")
    titulo = re.sub(r'^\s*\d{2}:\d{2}:\d{2}\s*', '', titulo)
    
    if "ESIDENT" in titulo or "NOCHE" in titulo or "RESIDENT EVIL" in titulo:
        return "RESIDENT EVIL: NOCHE CERO"
    if "MAN:" in titulo or "N NUE" in titulo or "SPIDER" in titulo:
        return "SPIDER-MAN: UN NUEVO DIA"
    
    match_tags = re.search(r'\s+(TRAD|T\.A\.|2D|2\.|DOB|\.OB|SUB)', titulo)
    if match_tags:
        titulo = titulo[:match_tags.start()]
        
    titulo = re.sub(r'\s*\([^)]*\)', '', titulo)
    return titulo.strip()

