                if int(p1) > 12:
                    fecha_us = f"{int(p2):02d}/{int(p1):02d}/{anio}"
                else:
                    fecha_us = f"{int(p1):02d}/{int(p2):02d}/{anio}"
                    
                cine_actual = valores[idx_fecha - 1].strip() if idx_fecha > 0 else "Desconocido"
                pelicula_actual = valores[idx_fecha + 1].strip()
                
                numeros = []
                for val in valores[idx_fecha+2:]:
                    val_limpio = val.replace('$', '').replace(',', '').strip()
                    if re.match(r'^-?\d+(?:\.\d+)?$', val_limpio):
                        numeros.append(float(val_limpio))
                        
                if len(numeros) >= 2:
                    ingreso = float(numeros[0])
                    asistentes = int(numeros[1])
                else:
                    continue
                    
                datos.append({
