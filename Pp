def procesar_formato_3_excel(df):
    print(f"  -> Extrayendo Formato 3 (Excel Estándar)...")
    datos = []
    textos_recientes = [] 
    
    for index, row in df.iterrows():
        valores = []
        for x in row.values:
            if pd.isna(x): continue
            if hasattr(x, 'strftime'):
                valores.append(x.strftime('%m/%d/%Y'))
            else:
                texto_celda = str(x).strip()
                match_iso = re.match(r'^(\d{4})-(\d{2})-(\d{2})', texto_celda)
                if match_iso:
                    anio, mes, dia = match_iso.groups()
                    valores.append(f"{mes}/{dia}/{anio}")
                elif texto_celda != '':
                    valores.append(texto_celda)
                    
        if not valores: continue
            
        match_fecha = None
        idx_fecha = -1
        for i, v in enumerate(valores):
            match = re.search(r'(\d{1,2})/(\d{1,2})/(\d{4})', v)
            if match:
                match_fecha = match
                idx_fecha = i
                break
                
        if match_fecha:
            p1, p2, anio = match_fecha.groups()
            if int(p1) > 12:
                fecha_us = f"{int(p2):02d}/{int(p1):02d}/{anio}"
            else:
                fecha_us = f"{int(p1):02d}/{int(p2):02d}/{anio}"
            
            if len(textos_recientes) >= 2:
                cine_actual = textos_recientes[-2]      
                pelicula_actual = textos_recientes[-1]  
            elif len(textos_recientes) == 1:
                cine_actual = textos_recientes[0]
                pelicula_actual = "Desconocida"
            else:
                cine_actual = "Desconocido"
                pelicula_actual = "Desconocida"
            
            try:
                asistentes = int(float(valores[idx_fecha + 1]))
                ingreso_texto = str(valores[idx_fecha + 3]).replace(',', '').replace('$', '').strip()
                ingreso = float(ingreso_texto) if ingreso_texto else 0.0
                
                datos.append({
                    'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': '', 
                    'CINE': cine_actual, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                    'PELICULA': limpiar_titulo_pelicula(pelicula_actual), 
                    '0': '', 'ASISTENTES': asistentes, 'INGRESO': ingreso
                })
            except Exception as e:
                pass
        else:
            full_text = " ".join(valores).strip()
            full_text = re.sub(r'\s+', ' ', full_text) 
            if not full_text: continue
            full_text_upper = full_text.upper()
            if full_text_upper.startswith(("TOTAL", "REPORTE", "PROVEEDOR", "EXHIBIDORA", "FECHA", "DIA")):
                continue
            if full_text_upper == "CINE" or full_text_upper.startswith("CINE DIA FECHA") or "CINE DIA" in full_text_upper:
                continue
            if not re.sub(r'[\d\s.,$%]', '', full_text):
                continue
            textos_recientes.append(full_text)

    print(f"     ✅ Formato 3: Se extrajeron {len(datos)} registros.")
    return datos

def procesar_formato_4_papeleta(df):
    print(f"  -> Extrayendo Formato 4 (Papeleta con Macros)...")
    datos = []
    cine_actual = "Desconocido"
    pelicula_actual = "Desconocida"
    
    for index, row in df.iterrows():
        valores_crudos = [str(x).strip() for x in row.values if pd.notna(x) and str(x).strip() != '']
        if not valores_crudos: continue
            
        texto_unido = " ".join(valores_crudos).upper()
        
        if "CINEMAS:" in texto_unido:
            for i, val in enumerate(valores_crudos):
                if val.upper() == "CINEMAS:" and i + 1 < len(valores_crudos):
                    cine_actual = valores_crudos[i+1]
                    break
        
        if "PELICULA:" in texto_unido:
            for i, val in enumerate(valores_crudos):
                if val.upper() == "PELICULA:" and i + 1 < len(valores_crudos):
                    pelicula_actual = valores_crudos[i+1]
                    break

        match_fecha = None
        for val in valores_crudos:
            if re.search(r'\d{1,2}/\d{1,2}/\d{4}', val) or re.search(r'\d{4}-\d{2}-\d{2}', val):
                match_fecha = val
                break
                
        if match_fecha and "SEMANA" not in texto_unido:
            try:
                if "-" in match_fecha:
                    anio, mes, dia = match_fecha.split(' ')[0].split('-')
                    fecha_us = f"{mes}/{dia}/{anio}"
                else:
                    partes = match_fecha.split('/')
                    fecha_us = f"{partes[0].zfill(2)}/{partes[1].zfill(2)}/{partes[2]}"

                ingreso_str = valores_crudos[-1].replace('$', '').replace(',', '').strip()
                asistentes_str = valores_crudos[-2].replace(',', '').strip()
                
                ingreso = float(ingreso_str)
                asistentes = int(float(asistentes_str))
                
                datos.append({
                    'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': '', 
                    'CINE': cine_actual, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                    'PELICULA': limpiar_titulo_pelicula(pelicula_actual), 
                    '0': '', 'ASISTENTES': asistentes, 'INGRESO': ingreso
                })
            except Exception as e:
                pass

    print(f"     ✅ Formato 4: Se extrajeron {len(datos)} registros.")
    return datos

def procesar_formato_6_cnx(df):
