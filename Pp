                })
            except Exception as e:
                pass

    print(f"     ✅ Formato 9: Se extrajeron {len(datos)} registros.")
    return datos

def procesar_formato_10_sedena(df):
    print(f"  -> Extrayendo Formato 10 (Excel Sedena / Columnas Directas)...")
    datos = []
    
    for index, row in df.iterrows():
        valores = [str(x).strip() if pd.notna(x) else "" for x in row.values]
        
        if len(valores) < 7:
            continue
            
        fecha_str = valores[2]
        
        if hasattr(row.values[2], 'strftime'):
            fecha_str = row.values[2].strftime('%m/%d/%Y')
        else:
            match_iso = re.match(r'^(\d{4})-(\d{2})-(\d{2})', fecha_str)
            if match_iso:
                anio, mes, dia = match_iso.groups()
                fecha_str = f"{mes}/{dia}/{anio}"

        match_fecha = re.search(r'(\d{1,2})/(\d{1,2})/(\d{4})', fecha_str)
        if not match_fecha:
            continue
            
        p1, p2, anio = match_fecha.groups()
        if int(p1) > 12: 
            fecha_us = f"{int(p2):02d}/{int(p1):02d}/{anio}"
        else: 
            fecha_us = f"{int(p1):02d}/{int(p2):02d}/{anio}"
            
        sala = valores[0].replace('$', '').strip()
        cine = valores[1]
        pelicula = valores[3]
        
        try:
            asistentes = int(float(valores[5]))
            ingreso_str = valores[6].replace('$', '').replace(',', '').strip()
            ingreso = float(ingreso_str) if ingreso_str else 0.0
            
            datos.append({
                'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': sala, 
                'CINE': cine, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                'PELICULA': limpiar_titulo_pelicula(pelicula), 
                '0': '', 'ASISTENTES': asistentes, 'INGRESO': ingreso
            })
        except Exception as e:
            pass

    print(f"     ✅ Formato 10: Se extrajeron {len(datos)} registros.")
    return datos

