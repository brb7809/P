                sala_actual = val_upper.replace("SALA", "").replace(":", "").strip()

        if "TOTAL" in texto_unido and "TAQUILLA" not in texto_unido:
            continue

        match_fecha = None
        idx_fecha = -1
        for i, val in enumerate(valores):
            if re.search(r'\d{1,2}/\d{1,2}/\d{4}', str(val)):
                match_fecha = str(val)
                idx_fecha = i
                break
                
        if match_fecha and idx_fecha + 2 < len(valores):
            match = re.search(r'(\d{1,2})/(\d{1,2})/(\d{4})', match_fecha)
            p1, p2, anio = match.groups()
            
            if int(p1) > 12: 
                fecha_us = f"{int(p2):02d}/{int(p1):02d}/{anio}"
            else: 
                fecha_us = f"{int(p1):02d}/{int(p2):02d}/{anio}"
            
            try:
                asistentes = int(float(valores[idx_fecha + 1]))
                ingreso_str = str(valores[idx_fecha + 2]).replace('$', '').replace(',', '').strip()
                ingreso = float(ingreso_str)
                
                datos.append({
                    'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': sala_actual, 
                    'CINE': cine_actual, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                    'PELICULA': limpiar_titulo_pelicula(pelicula_actual), 
                    '0': '', 'ASISTENTES': asistentes, 'INGRESO': ingreso
                })
            except Exception as e:
                pass

    print(f"     ✅ Formato 6: Se extrajeron {len(datos)} registros.")
    return datos

def procesar_formato_8_santalucia(df):
    print(f"  -> Extrayendo Formato 8 (S.D.N Santa Lucia)...")
    datos = []
    cine_actual = "S.D.N CINE SANTA LUCIA"
    pelicula_actual = "Desconocida"
            
    for index, row in df.iterrows():
        valores_fila = []
        for x in row.values:
            if pd.isna(x):
                valores_fila.append("")
            elif hasattr(x, 'strftime'):
                valores_fila.append(x.strftime('%m/%d/%Y')) 
            else:
                texto_celda = str(x).strip()
                match_iso = re.match(r'^(\d{4})-(\d{2})-(\d{2})', texto_celda)
                if match_iso:
                    anio, mes, dia = match_iso.groups()
                    valores_fila.append(f"{mes}/{dia}/{anio}")
                else:
                    valores_fila.append(texto_celda)

        texto_unido = " ".join(valores_fila).upper()
        texto_unido_limpio = re.sub(r'\s+', ' ', texto_unido)
        
        if "TITULO DE LA PELICULA" in texto_unido_limpio:
            match_pelicula = re.search(r'"([^"]*)"', texto_unido_limpio)
            if match_pelicula:
                pelicula_actual = match_pelicula.group(1)
            else:
                partes = texto_unido_limpio.split(":")
                if len(partes) > 1:
                    pelicula_actual = partes[1].strip()

        fecha_us = None
        for v in valores_fila:
            match_mmddyyyy = re.match(r'^(\d{2})/(\d{2})/(\d{4})$', v)
            if match_mmddyyyy:
                fecha_us = v
                break
                
            match_texto = re.search(r'(\d{1,2})\s+DE\s+([A-Z]+)\s+DE\s+(\d{4})', v.upper())
            if match_texto:
                dia, mes_str, anio = match_texto.groups()
                mes = MESES_COMPLETOS.get(mes_str.lower(), 1)
                fecha_us = f"{mes:02d}/{int(dia):02d}/{anio}"
                break
        
        if fecha_us:
            try:
                boletos_2d = 0
                if len(valores_fila) > 1 and valores_fila[1].replace('.', '').isdigit():
                    boletos_2d = int(float(valores_fila[1]))
                    
                boletos_3d = 0
                if len(valores_fila) > 4 and valores_fila[4].replace('.', '').isdigit():
                    boletos_3d = int(float(valores_fila[4]))
                    
                asistentes_totales = boletos_2d + boletos_3d
                
                ingreso = 0.0
                for v in reversed(valores_fila):
                    v_str = str(v).replace('$', '').replace(',', '').strip()
                    if re.match(r'^-?\d+(?:\.\d+)?$', v_str):
                        ingreso = float(v_str)
                        break
                
                datos.append({
                    'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': '', 
                    'CINE': cine_actual, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                    'PELICULA': limpiar_titulo_pelicula(pelicula_actual), 
                    '0': '', 'ASISTENTES': asistentes_totales, 'INGRESO': ingreso
                })
            except Exception as e:
                pass

    print(f"     ✅ Formato 8: Se extrajeron {len(datos)} registros.")
    return datos

def procesar_formato_9_tabla_directa(df):
    print(f"  -> Extrayendo Formato 9 (Tabla Columnas Pichucalco)...")
    datos = []
    
    for index, row in df.iterrows():
        valores = []
        for x in row.values:
            if pd.isna(x): 
                valores.append("")
            elif hasattr(x, 'strftime'):
                valores.append(x.strftime('%m/%d/%Y'))
            else:
                texto_celda = str(x).strip()
                match_iso = re.match(r'^(\d{4})-(\d{2})-(\d{2})', texto_celda)
                if match_iso:
                    anio, mes, dia = match_iso.groups()
                    valores.append(f"{mes}/{dia}/{anio}")
                else:
                    valores.append(texto_celda)
                    
        texto_unido = " ".join(valores).upper()
        if "TOTALES" in texto_unido:
            continue
            
        idx_fecha = -1
        match_fecha = None
        for i, v in enumerate(valores):
            if re.match(r'^\d{1,2}/\d{1,2}/\d{4}$', v):
                idx_fecha = i
                match_fecha = v
                break
                
        if match_fecha and idx_fecha >= 0:
            try:
