def procesar_formato_1(archivo_pdf):
    print(f"  -> Extrayendo Formato 1 (PDF Multifecha / Cineplex)...")
    datos = []
    try:
        with pdfplumber.open(archivo_pdf) as pdf:
            for pagina in pdf.pages:
                # Extraemos el texto asumiendo que es una tabla, esto preserva mejor los espacios entre columnas
                tabla = pagina.extract_table()
                
                if tabla:
                    # Si logra extraerlo como tabla, usamos esa estructura ordenada
                    fechas_col = []
                    dias_detectados = False
                    
                    for row in tabla:
                        # Limpiar nulos de la fila
                        row_limpia = [str(x).replace('\n', ' ').strip() if x else "" for x in row]
                        texto_fila = " ".join(row_limpia).upper()
                        
                        # Capturar fechas del encabezado
                        if not dias_detectados and ("JUE" in texto_fila or "VIE" in texto_fila):
                            # Buscar fechas en la fila usando Regex flexible
                            for celda in row_limpia:
                                match_fecha = re.search(r'([A-Za-z]{3})\s+(\d{1,2})-\s*([A-Za-z]{3})', celda, re.IGNORECASE)
                                if match_fecha:
                                    dia = match_fecha.group(2)
                                    mes_str = match_fecha.group(3)
                                    mes_num = MESES_ESPANOL.get(mes_str.capitalize(), 1)
                                    fecha_obj = datetime(AÑO_ACTUAL, mes_num, int(dia))
                                    fechas_col.append(fecha_obj.strftime('%m/%d/%Y'))
                            dias_detectados = True
                            continue
                            
                        # Extraer datos de ingresos y asistentes
                        if dias_detectados and len(fechas_col) >= 7 and "SONY" in texto_fila and "TOTAL" not in texto_fila:
                            # 1. Separar el texto principal (Cine, Película, Sala) de los números
                            cine = row_limpia[0] if len(row_limpia) > 0 else "Desconocido"
                            pelicula = row_limpia[1] if len(row_limpia) > 1 else "Desconocida"
                            
                            # La sala a veces se extrae junto con la distribuidora
                            sala = ""
                            dist_str = row_limpia[2] if len(row_limpia) > 2 else ""
                            if dist_str and dist_str[-1].isdigit():
                                sala = dist_str[-1]
                                
                            # 2. Extraer ingresos y asistentes
                            ingresos_actuales = []
                            asistentes_actuales = []
                            
                            # Los ingresos usualmente están en las celdas 4 a 10
                            for i in range(4, min(11, len(row_limpia))):
                                celda = row_limpia[i]
                                if "$" in celda:
                                    ingreso = float(celda.replace('$', '').replace(',', '').strip())
                                    ingresos_actuales.append(ingreso)
                                    
                            # Buscar en la fila SIGUIENTE (o dentro de la misma celda si se combinó) los asistentes
                            # Como a veces se combinan por salto de línea, usamos Regex en todo el texto del bloque
                            asistentes_str = re.findall(r'(?<!\$)\b\d+\b(?!%)', " ".join(row_limpia[4:]))
                            # Tomar los primeros 7 números enteros puros
                            asistentes_actuales = [int(x) for x in asistentes_str[:7]]
                            
                            # Consolidar
                            if len(ingresos_actuales) >= 7 and len(asistentes_actuales) >= 7:
                                for i in range(7):
                                    datos.append({
                                        'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': sala,
                                        'CINE': cine, 'FECHA': fechas_col[i] if i < len(fechas_col) else f"Dia {i+1}",
                                        'CODIGO DE PELICULA': '', 'PELICULA': limpiar_titulo_pelicula(pelicula), 
                                        '0': '', 'ASISTENTES': asistentes_actuales[i], 'INGRESO': ingresos_actuales[i]
                                    })
                
                else:
                    # FALLBACK: Si no es tabla, usar extracción de texto con espaciado preservado
                    texto = pagina.extract_text(layout=True)
                    if not texto: continue
                    
                    lineas = texto.split('\n')
                    fechas_col = []
                    
                    for linea in lineas[:15]:
                        matches = re.findall(r'([A-Za-z]{3})\s+(\d{1,2})-\s*([A-Za-z]{3})', linea, re.IGNORECASE)
                        if matches:
                            for match in matches[:7]:
                                dia = match[1]
                                mes_str = match[2]
                                mes_num = MESES_ESPANOL.get(mes_str.capitalize(), 1)
                                fecha_obj = datetime(AÑO_ACTUAL, mes_num, int(dia))
                                fechas_col.append(fecha_obj.strftime('%m/%d/%Y'))
                                
                    if not fechas_col:
                        fechas_col = [f"Dia {i+1}" for i in range(7)]
                        
                    buscando_asistentes = False
                    cine_actual = sala_actual = pelicula_actual = ""
                    ingresos_actuales = []
                    
                    for linea in lineas:
                        linea = linea.strip()
                        
                        if buscando_asistentes:
                            asistentes_str = re.findall(r'(?<!\$)\b\d+\b', linea)
                            if len(asistentes_str) >= 7:
                                asistentes_actuales = [int(x) for x in asistentes_str[:7]]
                                for i in range(7):
                                    datos.append({
                                        'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': sala_actual,
                                        'CINE': cine_actual, 'FECHA': fechas_col[i] if i < len(fechas_col) else f"Dia {i+1}",
                                        'CODIGO DE PELICULA': '', 'PELICULA': limpiar_titulo_pelicula(pelicula_actual), 
                                        '0': '', 'ASISTENTES': asistentes_actuales[i], 'INGRESO': ingresos_actuales[i]
                                    })
                            buscando_asistentes = False
                            continue
                            
                        if linea.count('$') >= 7 and "TOTAL" not in linea.upper():
                            # Separar por múltiples espacios para aislar las "columnas" generadas por el PDF
                            partes = re.split(r'\s{2,}', linea)
                            
                            if len(partes) >= 2:
                                # La primera parte suele ser el Cine
                                cine_actual = partes[0].strip()
                                # La segunda parte suele ser la Película
                                pelicula_bruta = partes[1].strip()
                                
                                # Limpieza extra si la película se pegó con la sala (Ej. "Resident Evil SONY 6")
                                if "SONY" in pelicula_bruta.upper():
                                    pelicula_actual = pelicula_bruta.split("SONY")[0].strip()
                                    resto = pelicula_bruta.split("SONY")[1].strip()
                                    if resto.isdigit():
                                        sala_actual = resto
                                else:
                                    pelicula_actual = pelicula_bruta
                                    
                            # Extraer ingresos
                            ingresos_str = re.findall(r'\$[\d,]+(?:\.\d{2})?', linea)
                            if len(ingresos_str) >= 7:
                                ingresos_actuales = [float(x.replace('$', '').replace(',', '')) for x in ingresos_str[:7]]
                                buscando_asistentes = True
                                
        print(f"     ✅ Formato 1: Se extrajeron {len(datos)} registros.")
    except Exception as e:
        print(f"     ❌ Error en Formato 1: {e}")
    return datos

def procesar_formato_2(archivo_pdf):
    print(f"  -> Extrayendo Formato 2 (PDF Por Fila)...")
    datos = []
    try:
        with pdfplumber.open(archivo_pdf) as pdf:
            for pagina in pdf.pages:
                texto = pagina.extract_text()
                if not texto: continue
                for linea in texto.split('\n'):
                    if "TOTAL" in linea.upper(): continue
                    match_fecha = re.search(r'(\d{2})/(\d{2})/(\d{4})', linea)
                    if not match_fecha: continue
                    dia, mes, anio = match_fecha.groups()
                    fecha_us = f"{mes}/{dia}/{anio}"
                    antes_fecha = linea[:match_fecha.start()].strip()
                    despues_fecha = linea[match_fecha.end():].strip()
                    match_sala = re.search(r'Sala\s*(\d+)', antes_fecha, re.IGNORECASE)
                    if match_sala:
                        sala = match_sala.group(1) 
                        cine_distribuidora = antes_fecha[:match_sala.start()].strip()
                    else:
                        sala, cine_distribuidora = "", antes_fecha
                    partes_cine = cine_distribuidora.split(maxsplit=1)
                    cine = partes_cine[1] if len(partes_cine) > 1 else cine_distribuidora
                    match_dinero = re.search(r'(\d+)\s+\$([\d,]+(?:\.\d{2})?)', despues_fecha)
                    if match_dinero:
                        datos.append({
                            'E/D': '', 'CODIGO DE CINE': '', 'NUMERO DE SALA': sala,
                            'CINE': cine, 'FECHA': fecha_us, 'CODIGO DE PELICULA': '',
                            'PELICULA': limpiar_titulo_pelicula(despues_fecha[:match_dinero.start()]), 
                            '0': '', 'ASISTENTES': int(match_dinero.group(1)),
                            'INGRESO': float(match_dinero.group(2).replace(',', ''))
                        })
        print(f"     ✅ Formato 2: Se extrajeron {len(datos)} registros.")
    except Exception as e:
        print(f"     ❌ Error en Formato 2: {e}")
    return datos

