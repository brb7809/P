                for linea in texto.split('\n'):
                    linea_limpia = linea.strip()
                    
                    if "CINEMAREY" in linea_limpia.upper():
                        match_cine = re.search(r'(CinemaRey)', linea_limpia, re.IGNORECASE)
                        if match_cine:
                            cine_actual = match_cine.group(1)

                    if " - " in linea_limpia and ("Releasing" in linea_limpia or "Pictures" in linea_limpia):
                        pelicula_bruta = linea_limpia.split(" - ")[-1].strip()
