# --- 4. FUNCIÓN PRINCIPAL DE REVISIÓN DE UN CORREO ---
def procesar_cliente(row_data, f_inicio, f_final):
    """Busca en los correos basándose en las fechas calculadas dadas. Retorna True si descargó."""
    email_contacto = str(row_data['email']).strip().lower()
    asunto_estructura = row_data['Subject']
    ruta_guardado = str(row_data['Ruta']).strip()
    nota_profunda = str(row_data.get('Nota', '')).strip().lower()
    
    # Calculamos variables para esta iteración
    valores = calcular_variables(f_inicio, f_final)
    patron_asunto = construir_patron_regex(asunto_estructura, valores)
    
    # Preparar datos para "búsqueda profunda"
    dia_inicio_limpio = str(int(valores['DIA_FECHA_INICIO']))
    mes_limpio = limpiar_texto(valores['MES_NOMBRE'])
    mes_abrev = mes_limpio[:3] # EXTRAE LAS PRIMERAS 3 LETRAS DEL MES (ej. "oct")
    
    descargado_algo = False
    
    for msg in mensajes_a_revisar:
        try:
            if msg.Class == 43:
                sender_email = obtener_email_remitente(msg)
                
                # 1. Coincide email?
                if email_contacto in sender_email:
                    asunto_limpio = limpiar_texto(msg.Subject)
                    
                    # 2. Coincide el Asunto?
                    if re.search(patron_asunto, asunto_limpio, re.IGNORECASE):
                        
                        cumple_profundidad = True
                        
                        # 3. Validar búsqueda profunda (si aplica)
                        if "body" in nota_profunda:
                            cuerpo_limpio = limpiar_texto(msg.Body)
                            # Se permite mes completo o abreviado
                            fechas_en_cuerpo = (dia_inicio_limpio in cuerpo_limpio and 
                                                (mes_limpio in cuerpo_limpio or mes_abrev in cuerpo_limpio))
                            
                            if "adjunto" in nota_profunda:
                                nombres_adjuntos = " ".join([limpiar_texto(a.FileName) for a in msg.Attachments])
                                # Se permite mes completo o abreviado
                                fechas_en_adjunto = (dia_inicio_limpio in nombres_adjuntos and 
                                                     (mes_limpio in nombres_adjuntos or mes_abrev in nombres_adjuntos))
                                cumple_profundidad = (fechas_en_cuerpo or fechas_en_adjunto)
                            else:
                                cumple_profundidad = fechas_en_cuerpo
                                
                        # 4. Si pasó todos los filtros, procedemos a descargar
                        if cumple_profundidad and msg.Attachments.Count > 0:
                            for att in msg.Attachments:
                                nombre_archivo = att.FileName
                                if nombre_archivo.lower().endswith(('.xlsx', '.xlsm', '.pdf')):
                                    if not os.path.exists(ruta_guardado):
                                        os.makedirs(ruta_guardado)
                                    ruta_archivo = os.path.join(ruta_guardado, nombre_archivo)
                                    att.SaveAsFile(ruta_archivo)
                                    print(f"Éxito: {email_contacto} -> {nombre_archivo}")
                                    descargado_algo = True
                                    
            if descargado_algo:
                return True # Rompemos el ciclo porque ya se descargó
        except Exception as e:
            pass
            
    return descargado_algo

# --- 5. ITERACIÓN SOBRE EL EXCEL ---
for index, row in df.iterrows():
    if pd.isna(row.get('email')): 
        continue
        
    print(f"\nBuscando: {row['email']}")
    
    # INTENTO 1: Buscar con las fechas base originales
    exito = procesar_cliente(row, fecha_inicio_base, fecha_final_base)
    
    # INTENTO 2: Si no se encontró y existe un "Ajuste fecha", recalcular e intentar de nuevo
    if not exito and pd.notna(row.get('Ajuste fecha')):
        try:
            dias_ajuste = int(row['Ajuste fecha'])
            print(f"  -> No encontrado. Aplicando ajuste de {dias_ajuste} días...")
            
            # Recalculamos las fechas
            nueva_fecha_inicio = fecha_inicio_base + datetime.timedelta(days=dias_ajuste)
            nueva_fecha_final = fecha_final_base + datetime.timedelta(days=dias_ajuste)
            
            # Volvemos a buscar con el ajuste
            exito = procesar_cliente(row, nueva_fecha_inicio, nueva_fecha_final)
        except ValueError:
            print("  -> Error: El valor en la columna 'Ajuste fecha' no es numérico.")
            
    # Registrar el resultado final
    if exito:
        df.at[index, 'Estado Descarga'] = 'Descargado'

