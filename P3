# --- 1. FUNCIONES DE LIMPIEZA Y CÁLCULO ---
def limpiar_texto(texto):
    """Quita tildes, convierte a minúsculas, elimina espacios dobles y ceros a la izquierda en días."""
    if pd.isna(texto): 
        return ""
    texto = str(texto).lower() # Todo a minúsculas para facilitar búsqueda
    # Quitar tildes y acentos
    texto_sin_tildes = ''.join((c for c in unicodedata.normalize('NFD', texto) if unicodedata.category(c) != 'Mn'))
    # Quitar espacios múltiples y dejar solo uno
    texto_limpio = " ".join(texto_sin_tildes.split())
    
    # Quita el '0' a la izquierda en números del 01 al 09 de forma invisible
    texto_limpio = re.sub(r'\b0([1-9])\b', r'\1', texto_limpio)
    
    return texto_limpio

def calcular_variables(f_inicio, f_final):
    """Calcula y devuelve el diccionario de variables basado en las fechas dadas."""
    meses = {
        1: "Enero", 2: "Febrero", 3: "Marzo", 4: "Abril", 5: "Mayo", 6: "Junio",
        7: "Julio", 8: "Agosto", 9: "Septiembre", 10: "Octubre", 11: "Noviembre", 12: "Diciembre"
    }
    return {
        "MES_NOMBRE": meses[f_inicio.month],
        "NUMERO_SEMANA": f_inicio.isocalendar()[1],
        "DIA_FECHA_INICIO": str(f_inicio.day), # .day evita el cero a la izquierda
        "DIA_FECHA_FINAL": str(f_final.day),   # .day evita el cero a la izquierda
        "AÑO": f_inicio.year,
        "AÑO_ULTIMOSDOS": f_inicio.strftime("%y")
    }

def construir_patron_regex(plantilla, valores):
    """Sustituye variables si existen, y prepara el texto para búsqueda flexible."""
    if pd.isna(plantilla): return ".*"
    
    plantilla = str(plantilla)
    for clave, valor in valores.items():
        plantilla = plantilla.replace("{{" + clave + "}}", str(valor))
    
    # 1. Usamos una palabra de seguridad ya en minúsculas
    plantilla = plantilla.replace("{{TEXTO}}", "comodintexto")
    
    # 2. Limpiamos (esto no afectará nuestra palabra de seguridad)
    plantilla_limpia = limpiar_texto(plantilla)
    
    patron_escapado = re.escape(plantilla_limpia)
    
    # 3. Reemplazamos buscando en minúsculas
    patron_final = patron_escapado.replace("comodintexto", ".*")
    patron_final = patron_final.replace(r"\ ", r"\s+").replace(" ", r"\s+")
    
    return patron_final

def obtener_email_remitente(msg):
    try:
        if msg.SenderEmailType == "EX":
            return msg.Sender.GetExchangeUser().PrimarySmtpAddress.lower()
    except Exception:
        pass
    return msg.SenderEmailAddress.lower()

